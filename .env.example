# Nutrient license keys. Leave empty to run the SDKs in evaluation mode.
NUTRIENT_LICENSE_KEY=
NUTRIENT_WEB_SDK_LICENSE_KEY=

# LLM used by the structured extraction: openai, anthropic, local (any
# OpenAI-compatible endpoint, for example an Azure-hosted deployment) or
# ollama (a local model, nothing leaves the machine).
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o
AI_ENDPOINT=
# Vision model for the handwriting (page image) pass. Empty = AI_MODEL.
IMAGE_MODEL=
# Ollama server, used when AI_PROVIDER=ollama.
OLLAMA_URL=http://127.0.0.1:11434
# Answer length cap and presence penalty the relay adds to Ollama requests.
OLLAMA_MAX_TOKENS=2000
OLLAMA_PRESENCE_PENALTY=0.6

# Reading options
VISION_ENGINE=icr
VISION_FEATURES=TABLE
LAYOUT_CONFIDENCE=0.2
IMAGE_PASS=1
IMAGE_WORKERS=4
VLM_FAST_MODE=1
REVIEW_BELOW=70

# Server
PORT=8080
INPUT_DIR=
OUTPUT_DIR=
